# Sao chép thành .env.local rồi điền giá trị thật

# Địa chỉ website khi chạy thật (dùng cho SEO, sitemap, ảnh chia sẻ)
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Trang quản trị /admin (xem danh sách khách để lại thông tin) ---
# Bắt buộc nếu muốn dùng /admin. Đặt mật khẩu dài, khó đoán.
ADMIN_PASSWORD=
# Tuỳ chọn: khoá ký phiên đăng nhập (mặc định dùng ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=

# --- Nơi lưu thông tin khách ---
# Mặc định lưu file JSON ở ./.data. Khi deploy lên Vercel/serverless, ổ đĩa không bền vững:
# hãy gắn volume cho DATA_DIR, hoặc dùng INQUIRY_WEBHOOK_URL / Telegram bên dưới để nhận thông tin ngay.
DATA_DIR=.data

# --- Nhận thông báo ngay khi có khách để lại thông tin (tuỳ chọn) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Webhook bất kỳ (Make/Zapier/n8n/Google Apps Script...), nhận JSON POST
INQUIRY_WEBHOOK_URL=
